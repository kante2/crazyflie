Panels:
- Class: rviz_common/Displays
  Help Height: 60
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.48
  Tree Height: 610
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.22
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 75; 85; 100
    Enabled: true
    Line Style:
      Line Width: 0.012
      Value: Lines
    Name: Reference grid · 1 m
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Future path · 4 s
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trajectory/paths
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Occupied space · 0.18 m
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trajectory/occupancy
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Recent flight trail
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trajectory/trails
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Destinations
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trajectory/goals
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Drones and status
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trajectory/markers
    Value: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 15
    Frames:
      All Enabled: true
      cf1:
        Value: true
      cf2:
        Value: true
      cf3:
        Value: true
      cf4:
        Value: true
      world:
        Value: true
    Marker Scale: 0.16
    Name: Frames (optional)
    Show Arrows: false
    Show Axes: true
    Show Names: false
    Tree:
      world:
        cf1: {}
        cf2: {}
        cf3: {}
        cf4: {}
    Update Interval: 0
    Value: false
  Enabled: true
  Global Options:
    Background Color: 22; 27; 35
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: -0.3
        Y: 0.3
        Z: 1.1
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Overview
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.85
    Saved:
    - Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Angle: 0.0
      Scale: 80.0
      X: -0.3
      Y: 0.3
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 000000ff00000000fd000000010000000000000156000002fcfc0200000001fb000000100044006900730070006c006100790073010000003b000002fc000000c700ffffff00000386000002fc00000004000000040000000800000008fc0000000100000002000000010000000a0054006f006f006c00730100000000ffffffff0000000000000000
  Width: 1440
  X: 60
  Y: 40
  Views:
    collapsed: false
